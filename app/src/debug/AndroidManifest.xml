        <receiver
            android:name=".debug.TurboProbe"
            android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="dev.kaff.app.TURBO_PROBE" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
