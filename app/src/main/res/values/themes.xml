<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Kaff" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/kaff_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <style name="Theme.Kaff.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/kaff_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash_mark</item>
        <item name="postSplashScreenTheme">@style/Theme.Kaff</item>
    </style>
</resources>
