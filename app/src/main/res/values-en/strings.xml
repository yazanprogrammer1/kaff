    <!-- Permissions -->
    <string name="perm_title">A few permissions</string>
    <string name="perm_body">Kaff only asks for what it actually uses:</string>
    <string name="perm_camera_title">Camera</string>
    <string name="perm_camera_body">To see your hand while sending or receiving. Everything is analyzed on your phone.</string>
    <string name="perm_nearby_title">Nearby devices</string>
    <string name="perm_nearby_body">To find the other phone and connect directly, without internet.</string>
    <string name="perm_location_title">Location</string>
    <string name="perm_location_body">Google Play services Nearby needs PRECISE location to find the other phone. Choose "Precise" in the prompt. Kaff never reads or stores your location.</string>
    <string name="perm_notifications_title">Notifications</string>
    <string name="perm_notifications_body">To tell you when someone wants to send you a file while Kaff is in the background.</string>
