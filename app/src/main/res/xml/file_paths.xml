<?xml version="1.0" encoding="utf-8"?>
<!-- Android 8-9: received files live in the app's external folder and are shared through FileProvider.
     shared/: text or links shared to Kaff, turned into .txt files. -->
<paths>
    <external-files-path name="received" path="." />
    <files-path name="received_internal" path="." />
    <cache-path name="shared_text" path="shared/" />
</paths>
